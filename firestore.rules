rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidJogador(data) {
      return data.keys().hasAll(['email', 'nome', 'pix', 'pontos']) &&
        data.keys().hasOnly([
          'email',
          'nome',
          'pix',
          'pontos',
          'statusPagamento',
          'comprovante',
          'timestampComprovante',
          'dataEnvioComprovante',
          'dataAprovacao',
          'dataCadastro',
          'timestampCadastro',
          'id',
          'link_pagamento',
          'status_pagamento',
          'aprovado',
          'aprovado_em'
        ]) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100 &&
        data.pix is string && data.pix.size() >= 1 && data.pix.size() <= 120 &&
        data.pontos is number &&
        (!('statusPagamento' in data) || (data.statusPagamento is string && data.statusPagamento in ['PENDENTE', 'EM_ANALISE', 'APROVADO', 'RECUSADO'])) &&
        (!('comprovante' in data) || (data.comprovante is string && data.comprovante.size() <= 900000)) &&
        (!('timestampComprovante' in data) || data.timestampComprovante is number) &&
        (!('dataEnvioComprovante' in data) || (data.dataEnvioComprovante is string && data.dataEnvioComprovante.size() <= 60)) &&
        (!('dataAprovacao' in data) || (data.dataAprovacao is string && data.dataAprovacao.size() <= 60)) &&
        (!('dataCadastro' in data) || (data.dataCadastro is string && data.dataCadastro.size() <= 60)) &&
        (!('timestampCadastro' in data) || data.timestampCadastro is number) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 120)) &&
        (!('link_pagamento' in data) || (data.link_pagamento is string && data.link_pagamento.size() <= 2000)) &&
        (!('status_pagamento' in data) || (data.status_pagamento is string && data.status_pagamento.size() <= 40)) &&
        (!('aprovado' in data) || data.aprovado is bool) &&
        (!('aprovado_em' in data) || (data.aprovado_em is string && data.aprovado_em.size() <= 100));
    }

    function isValidJogo(data) {
      return data.keys().hasAll(['id', 'casa', 'fora', 'escudoCasa', 'escudoFora', 'data', 'estadio']) &&
        data.keys().hasOnly(['id', 'casa', 'fora', 'escudoCasa', 'escudoFora', 'data', 'estadio', 'resultadoOficial', 'publicado', 'bolaoId', 'tituloBolao']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.casa is string && data.casa.size() >= 1 && data.casa.size() <= 80 &&
        data.fora is string && data.fora.size() >= 1 && data.fora.size() <= 80 &&
        data.escudoCasa is string && data.escudoCasa.size() <= 500000 &&
        data.escudoFora is string && data.escudoFora.size() <= 500000 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 60 &&
        data.estadio is string && data.estadio.size() >= 1 && data.estadio.size() <= 100 &&
        (!('resultadoOficial' in data) || (data.resultadoOficial is string && data.resultadoOficial in ['CASA', 'EMPATE', 'FORA'])) &&
        (!('publicado' in data) || data.publicado is bool) &&
        (!('bolaoId' in data) || (data.bolaoId is string && data.bolaoId.size() <= 80)) &&
        (!('tituloBolao' in data) || (data.tituloBolao is string && data.tituloBolao.size() <= 120));
    }

    function isValidPalpite(data) {
      return data.keys().hasAll(['jogadorEmail', 'jogoId', 'escolha', 'pago']) &&
        data.keys().hasOnly(['jogadorEmail', 'jogoId', 'escolha', 'pago']) &&
        data.jogadorEmail is string && data.jogadorEmail.size() >= 3 && data.jogadorEmail.size() <= 120 &&
        data.jogoId is string && data.jogoId.size() >= 1 && data.jogoId.size() <= 64 &&
        data.escolha is string && data.escolha in ['CASA', 'EMPATE', 'FORA'] &&
        data.pago is bool;
    }

    function isValidConfig(data) {
      return data.keys().hasOnly(['valor', 'valorCota', 'precoCota', 'handle', 'chavePix', 'nomePix', 'cidadePix', 'pixAdm', 'linkPagamentoInfinitePay']) &&
        (!('valor' in data) || (data.valor is number && data.valor >= 0)) &&
        (!('valorCota' in data) || (data.valorCota is number && data.valorCota >= 0)) &&
        (!('precoCota' in data) || (data.precoCota is number && data.precoCota >= 0)) &&
        (!('handle' in data) || (data.handle is string && data.handle.size() <= 120)) &&
        (!('chavePix' in data) || (data.chavePix is string && data.chavePix.size() >= 1 && data.chavePix.size() <= 120)) &&
        (!('nomePix' in data) || (data.nomePix is string && data.nomePix.size() >= 1 && data.nomePix.size() <= 60)) &&
        (!('cidadePix' in data) || (data.cidadePix is string && data.cidadePix.size() >= 1 && data.cidadePix.size() <= 60)) &&
        (!('pixAdm' in data) || (data.pixAdm is string && data.pixAdm.size() >= 1 && data.pixAdm.size() <= 120)) &&
        (!('linkPagamentoInfinitePay' in data) || (data.linkPagamentoInfinitePay is string && data.linkPagamentoInfinitePay.size() <= 2000));
    }

    function isValidJogoDisponivel(data) {
      return data.keys().hasAll(['id', 'time_casa', 'time_fora', 'campeonato', 'horario', 'data', 'adicionado_ao_bolao']) &&
        data.keys().hasOnly(['id', 'time_casa', 'time_fora', 'campeonato', 'horario', 'data', 'adicionado_ao_bolao']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 120 &&
        data.time_casa is string && data.time_casa.size() >= 1 && data.time_casa.size() <= 100 &&
        data.time_fora is string && data.time_fora.size() >= 1 && data.time_fora.size() <= 100 &&
        data.campeonato is string && data.campeonato.size() >= 1 && data.campeonato.size() <= 120 &&
        data.horario is string && data.horario.size() >= 1 && data.horario.size() <= 60 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 40 &&
        data.adicionado_ao_bolao is bool;
    }

    function isValidDeposito(data) {
      return data.keys().hasAll(['userId', 'valor', 'status', 'chaveDestino', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'valor', 'status', 'chaveDestino', 'createdAt', 'nome', 'email', 'id']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.valor is number && data.valor >= 0 &&
        data.status is string && data.status in ['CONFIRMADO', 'APROVADO', 'PENDENTE'] &&
        data.chaveDestino is string && data.chaveDestino.size() >= 1 && data.chaveDestino.size() <= 120 &&
        (data.createdAt is string || data.createdAt is timestamp || data.createdAt is number) &&
        (!('nome' in data) || (data.nome is string && data.nome.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    function isValidComprovantePremiacao(data) {
      return data.keys().hasAll(['id', 'ganhadorNome', 'colocacao', 'valorPago', 'imagemComprovante', 'dataEnvio', 'timestamp']) &&
        data.keys().hasOnly(['id', 'ganhadorNome', 'colocacao', 'valorPago', 'descricao', 'imagemComprovante', 'dataEnvio', 'timestamp']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 120 &&
        data.ganhadorNome is string && data.ganhadorNome.size() >= 1 && data.ganhadorNome.size() <= 120 &&
        data.colocacao is string && data.colocacao.size() >= 1 && data.colocacao.size() <= 80 &&
        data.valorPago is number && data.valorPago >= 0 &&
        (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 200)) &&
        data.imagemComprovante is string && data.imagemComprovante.size() >= 1 && data.imagemComprovante.size() <= 900000 &&
        data.dataEnvio is string && data.dataEnvio.size() >= 1 && data.dataEnvio.size() <= 80 &&
        data.timestamp is number;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /jogadores/{jogadorId} {
      allow get: if isValidId(jogadorId);
      allow list: if request.time != null;
      allow create: if isValidId(jogadorId) && isValidJogador(incoming());
      allow update: if isValidId(jogadorId) && isValidJogador(incoming()) &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nome',
          'pix',
          'pontos',
          'statusPagamento',
          'comprovante',
          'timestampComprovante',
          'dataEnvioComprovante',
          'dataAprovacao',
          'dataCadastro',
          'timestampCadastro',
          'id',
          'link_pagamento',
          'status_pagamento',
          'aprovado',
          'aprovado_em'
        ]);
      allow delete: if isValidId(jogadorId);
    }

    match /jogos/{jogoId} {
      allow get: if isValidId(jogoId);
      allow list: if request.time != null;
      allow create: if isValidId(jogoId) && isValidJogo(incoming());
      allow update: if isValidId(jogoId) && isValidJogo(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'casa',
          'fora',
          'escudoCasa',
          'escudoFora',
          'data',
          'estadio',
          'resultadoOficial',
          'publicado',
          'bolaoId',
          'tituloBolao'
        ]);
      allow delete: if isValidId(jogoId);
    }

    match /palpites/{palpiteId} {
      allow get: if isValidId(palpiteId);
      allow list: if request.time != null;
      allow create: if isValidId(palpiteId) && isValidPalpite(incoming());
      allow update: if isValidId(palpiteId) && isValidPalpite(incoming()) &&
        incoming().jogadorEmail == existing().jogadorEmail &&
        incoming().jogoId == existing().jogoId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['escolha', 'pago']);
      allow delete: if isValidId(palpiteId);
    }

    match /config/{configId} {
      allow get: if isValidId(configId);
      allow list: if request.time != null;
      allow create: if isValidId(configId) && isValidConfig(incoming());
      allow update: if isValidId(configId) && isValidConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['valor', 'valorCota', 'precoCota', 'handle', 'chavePix', 'nomePix', 'cidadePix', 'pixAdm', 'linkPagamentoInfinitePay']);
      allow delete: if isValidId(configId);
    }

    match /jogos_disponiveis/{jogoDisponivelId} {
      allow get: if isValidId(jogoDisponivelId);
      allow list: if request.time != null;
      allow create: if isValidId(jogoDisponivelId) && isValidJogoDisponivel(incoming());
      allow update: if isValidId(jogoDisponivelId) && isValidJogoDisponivel(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'time_casa',
          'time_fora',
          'campeonato',
          'horario',
          'data',
          'adicionado_ao_bolao'
        ]);
      allow delete: if isValidId(jogoDisponivelId);
    }

    match /depositos/{depositoId} {
      allow get: if isValidId(depositoId);
      allow list: if request.time != null;
      allow create: if isValidId(depositoId) && isValidDeposito(incoming());
      allow update: if isValidId(depositoId) && isValidDeposito(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'valor',
          'status',
          'chaveDestino',
          'createdAt',
          'nome',
          'email',
          'id'
        ]);
      allow delete: if isValidId(depositoId);
    }

    match /comprovantes_premiacao/{comprovanteId} {
      allow get: if isValidId(comprovanteId);
      allow list: if request.time != null;
      allow create: if isValidId(comprovanteId) && isValidComprovantePremiacao(incoming());
      allow update: if isValidId(comprovanteId) && isValidComprovantePremiacao(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'ganhadorNome',
          'colocacao',
          'valorPago',
          'descricao',
          'imagemComprovante',
          'dataEnvio',
          'timestamp'
        ]);
      allow delete: if isValidId(comprovanteId);
    }
  }
}
