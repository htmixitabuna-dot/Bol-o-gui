rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidJogador(data) {
      return data.keys().hasAll(['email', 'nome', 'pix', 'pontos']) &&
        data.keys().hasOnly([
          'email',
          'nome',
          'pix',
          'pontos',
          'statusPagamento',
          'comprovante',
          'timestampComprovante',
          'dataEnvioComprovante',
          'dataAprovacao',
          'dataCadastro',
          'timestampCadastro'
        ]) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100 &&
        data.pix is string && data.pix.size() >= 1 && data.pix.size() <= 120 &&
        data.pontos is number &&
        (!('statusPagamento' in data) || (data.statusPagamento is string && data.statusPagamento in ['PENDENTE', 'EM_ANALISE', 'APROVADO', 'RECUSADO'])) &&
        (!('comprovante' in data) || (data.comprovante is string && data.comprovante.size() <= 900000)) &&
        (!('timestampComprovante' in data) || data.timestampComprovante is number) &&
        (!('dataEnvioComprovante' in data) || (data.dataEnvioComprovante is string && data.dataEnvioComprovante.size() <= 60)) &&
        (!('dataAprovacao' in data) || (data.dataAprovacao is string && data.dataAprovacao.size() <= 60)) &&
        (!('dataCadastro' in data) || (data.dataCadastro is string && data.dataCadastro.size() <= 60)) &&
        (!('timestampCadastro' in data) || data.timestampCadastro is number);
    }

    function isValidJogo(data) {
      return data.keys().hasAll(['id', 'casa', 'fora', 'escudoCasa', 'escudoFora', 'data', 'estadio']) &&
        data.keys().hasOnly(['id', 'casa', 'fora', 'escudoCasa', 'escudoFora', 'data', 'estadio', 'resultadoOficial']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.casa is string && data.casa.size() >= 1 && data.casa.size() <= 80 &&
        data.fora is string && data.fora.size() >= 1 && data.fora.size() <= 80 &&
        data.escudoCasa is string && data.escudoCasa.size() <= 500000 &&
        data.escudoFora is string && data.escudoFora.size() <= 500000 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 60 &&
        data.estadio is string && data.estadio.size() >= 1 && data.estadio.size() <= 100 &&
        (!('resultadoOficial' in data) || (data.resultadoOficial is string && data.resultadoOficial in ['CASA', 'EMPATE', 'FORA']));
    }

    function isValidPalpite(data) {
      return data.keys().hasAll(['jogadorEmail', 'jogoId', 'escolha', 'pago']) &&
        data.keys().hasOnly(['jogadorEmail', 'jogoId', 'escolha', 'pago']) &&
        data.jogadorEmail is string && data.jogadorEmail.size() >= 3 && data.jogadorEmail.size() <= 120 &&
        data.jogoId is string && data.jogoId.size() >= 1 && data.jogoId.size() <= 64 &&
        data.escolha is string && data.escolha in ['CASA', 'EMPATE', 'FORA'] &&
        data.pago is bool;
    }

    function isValidConfig(data) {
      return data.keys().hasAll(['valor', 'chavePix', 'nomePix', 'cidadePix', 'pixAdm']) &&
        data.keys().hasOnly(['valor', 'chavePix', 'nomePix', 'cidadePix', 'pixAdm']) &&
        data.valor is number && data.valor >= 0 &&
        data.chavePix is string && data.chavePix.size() >= 1 && data.chavePix.size() <= 120 &&
        data.nomePix is string && data.nomePix.size() >= 1 && data.nomePix.size() <= 60 &&
        data.cidadePix is string && data.cidadePix.size() >= 1 && data.cidadePix.size() <= 60 &&
        data.pixAdm is string && data.pixAdm.size() >= 1 && data.pixAdm.size() <= 120;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /jogadores/{jogadorId} {
      allow get: if isValidId(jogadorId);
      allow list: if existing().email is string && existing().email.size() <= 120;
      allow create: if isValidId(jogadorId) && isValidJogador(incoming());
      allow update: if isValidId(jogadorId) && isValidJogador(incoming()) &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nome',
          'pix',
          'pontos',
          'statusPagamento',
          'comprovante',
          'timestampComprovante',
          'dataEnvioComprovante',
          'dataAprovacao',
          'dataCadastro',
          'timestampCadastro'
        ]);
      allow delete: if isValidId(jogadorId);
    }

    match /jogos/{jogoId} {
      allow get: if isValidId(jogoId);
      allow list: if existing().id is string && existing().id.size() <= 64;
      allow create: if isValidId(jogoId) && isValidJogo(incoming());
      allow update: if isValidId(jogoId) && isValidJogo(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'casa',
          'fora',
          'escudoCasa',
          'escudoFora',
          'data',
          'estadio',
          'resultadoOficial'
        ]);
      allow delete: if isValidId(jogoId);
    }

    match /palpites/{palpiteId} {
      allow get: if isValidId(palpiteId);
      allow list: if existing().jogadorEmail is string && existing().jogadorEmail.size() <= 120;
      allow create: if isValidId(palpiteId) && isValidPalpite(incoming());
      allow update: if isValidId(palpiteId) && isValidPalpite(incoming()) &&
        incoming().jogadorEmail == existing().jogadorEmail &&
        incoming().jogoId == existing().jogoId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['escolha', 'pago']);
      allow delete: if isValidId(palpiteId);
    }

    match /config/{configId} {
      allow get: if isValidId(configId);
      allow list: if existing().chavePix is string && existing().chavePix.size() <= 120;
      allow create: if isValidId(configId) && isValidConfig(incoming());
      allow update: if isValidId(configId) && isValidConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['valor', 'chavePix', 'nomePix', 'cidadePix', 'pixAdm']);
      allow delete: if isValidId(configId);
    }
  }
}
